# ==========================================================
# 📲 LADYDREAM | Mensageria WhatsApp (Python + n8n)
# Arquivo de exemplo — NÃO versionar o .env real
# ==========================================================

# ----------------------------------------------------------
# 📁 CAMINHOS LOCAIS (ajuste conforme seu ambiente)
# ----------------------------------------------------------

# Caminho completo para a planilha Excel com os telefones
CAMINHO_ARQUIVO=C:/caminho/para/Telefones.xlsx

# Caminho completo para a imagem de saudação (PNG ou JPG)
FOTO=C:/caminho/para/imagem_saudacao_ladydream.png


# ----------------------------------------------------------
# 🌐 ENDPOINTS DO N8N
# ----------------------------------------------------------

# Webhook do n8n responsável pelo upload da imagem
URL_N8N_IMG_POST=https://seu-n8n/webhook/post-imagem

# Webhook do n8n responsável pelo disparo da mensagem
URL_N8N=https://seu-n8n/webhook/disparo-mensagem


# ----------------------------------------------------------
# 🔐 AUTENTICAÇÃO (opcional)
# ----------------------------------------------------------

# Define se o n8n exige autenticação básica
# true  = n8n protegido por usuário e senha
# false = n8n sem autenticação
USE_AUTH=false

# Usuário do n8n (obrigatório apenas se USE_AUTH=true)
USUARIO_N8N=seu_usuario_n8n

# Senha do n8n (obrigatória apenas se USE_AUTH=true)
SENHA_N8N=sua_senha_n8n

# ----------------------------------------------------------
# 🧪 EXEMPLO FINAL DE CONFIGURAÇÃO (APENAS REFERÊNCIA)
# ----------------------------------------------------------
# ⚠️ ATENÇÃO:
# Este bloco é apenas um EXEMPLO de como o .env final pode
# ficar após preenchido.
# NÃO utilize valores reais em repositórios públicos.
# NÃO versionar o .env real.
# ----------------------------------------------------------

# CAMINHOS LOCAIS
CAMINHO_ARQUIVO=C:/Users/usuario/OneDrive/N8N/Mensageria/Telefones.xlsx
FOTO=C:/Users/usuario/OneDrive/N8N/Mensageria/imagem_saudacao.png

# ENDPOINTS N8N
URL_N8N_IMG_POST=https://seu-n8n/webhook/post-imagem
URL_N8N=https://seu-n8n/webhook/disparo-mensagem

# AUTENTICAÇÃO
USE_AUTH=false
USUARIO_N8N=usuario_n8n
SENHA_N8N=senha_n8n
